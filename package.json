{
  "name": "distrito-geek-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:monitor": "node --test scripts/production-smoke.node-test.mjs",
    "monitor:production": "node scripts/production-smoke.mjs",
    "lighthouse:production": "npx --yes @lhci/cli@0.15.1 autorun",
    "import:seed": "node scripts/import-marketplace.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.10",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.85.5",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@netlify/functions": "^4.2.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "netlify-cli": "^23.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
